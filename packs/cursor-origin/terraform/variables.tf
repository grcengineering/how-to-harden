variable "hth_origin_owner" {
  type        = string
  description = "Reviewed Origin owner slug; network and SSH namespace policies require an eligible team namespace."
  validation {
    condition     = length(trimspace(var.hth_origin_owner)) > 0 && !strcontains(var.hth_origin_owner, "/")
    error_message = "Supply the actual reviewed owner slug, without a repository path."
  }
}

variable "hth_origin_repo" {
  type        = string
  description = "Reviewed existing Origin repository name. These examples do not create or delete repositories."
  validation {
    condition     = length(trimspace(var.hth_origin_repo)) > 0 && !strcontains(var.hth_origin_repo, "/")
    error_message = "Supply the actual repository name within the selected owner."
  }
}

variable "hth_manage_rulesets" {
  type        = bool
  default     = false
  description = "Explicit opt-in to manage the two ruleset examples after existing rules and bypasses have been inventoried/imported and reviewed."
}

variable "hth_ruleset_name" {
  type        = string
  default     = "hth-reviewed-branch"
  description = "Name prefix for the separately managed merge and push rulesets."
}

variable "hth_protected_refs" {
  type        = list(string)
  default     = ["~DEFAULT_BRANCH"]
  description = "Explicit refs/patterns to protect; Origin supports ~ALL and ~DEFAULT_BRANCH."
  validation {
    condition     = length(var.hth_protected_refs) > 0 && length(var.hth_protected_refs) <= 64 && alltrue([for ref in var.hth_protected_refs : length(trimspace(ref)) > 0])
    error_message = "Provide one to 64 nonempty intended reference patterns."
  }
}

variable "hth_required_check" {
  type = object({
    actor_kind = string
    actor_id   = string
    group_key  = string
  })
  default     = null
  description = "One actual trusted check-reporting actor and group key. Required before managing the example; add further explicit required_check blocks after reviewing existing protections."
  validation {
    condition     = var.hth_required_check == null ? true : alltrue([for value in values(var.hth_required_check) : length(trimspace(value)) > 0])
    error_message = "The required check needs its actual actor kind, actor ID and group key."
  }
}

variable "hth_read_ip_posture" {
  type        = bool
  default     = false
  description = "Opt in to the namespace IP-allowlist data-source read; also read when management is enabled."
}

variable "hth_manage_ip_allowlist" {
  type        = bool
  default     = false
  description = "Explicitly manage reviewed per-entry resources and the namespace enforcement flag. Existing whole-set ownership must be resolved first."
}

variable "hth_enforce_ip_allowlist" {
  type        = bool
  default     = false
  description = "Enable enforcement only after an independent recovery path and every required caller egress address are proven."
}

variable "hth_origin_egress_cidrs" {
  type        = map(string)
  default     = {}
  description = "Reviewed caller egress CIDR => description. Include Terraform/CI and independently tested recovery access; use one ownership model per namespace."
  validation {
    condition     = length(var.hth_origin_egress_cidrs) <= 1000 && alltrue([for cidr, label in var.hth_origin_egress_cidrs : can(cidrhost(cidr, 0)) && !can(regex("/0+$", cidr)) && length(label) <= 255])
    error_message = "Supply at most 1000 valid CIDRs with a nonzero prefix and descriptions of at most 255 characters."
  }
}

variable "hth_read_ssh_posture" {
  type        = bool
  default     = false
  description = "Opt in to the namespace SSH-CA data-source read; also read when management is enabled."
}

variable "hth_manage_ssh_ca" {
  type        = bool
  default     = false
  description = "Explicitly manage/import the reviewed CA public key. No private key or certificate is generated by this pack."
}

variable "hth_ssh_ca_name" {
  type        = string
  default     = "hth-reviewed-organization-ca"
  description = "Approved CA label. Origin does not support renaming an existing authority."
}

variable "hth_ssh_ca_public_key" {
  type        = string
  default     = ""
  description = "Approved CA public key in documented OpenSSH form, never a private key. Required when managing the authority."
}

variable "hth_require_ssh_certificates" {
  type        = bool
  default     = false
  description = "Explicit opt-in to create the certificate-requirement policy; blocks registered user SSH keys and user API keys over HTTPS."
}

variable "hth_recovery_access_tested" {
  type        = bool
  default     = false
  description = "Operator attestation that an independent recovery access path was proven before any restrictive policy. This Boolean is not evidence of a real test."
}
