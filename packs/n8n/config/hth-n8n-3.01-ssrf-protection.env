# HTH 3.1: ssrf-protection
# Profile: L2 (Walk); NIST 800-53 SC-7
# Guide: https://howtoharden.com/guides/n8n/#31
# Source: https://docs.n8n.io/deploy/host-n8n/configure-n8n/security/enable-ssrf-protection.md
# Native self-hosted n8n environment file; merge into deployment configuration.
# Requires n8n 2.12.0+. Supplement with network egress controls.
# HTH Guide Excerpt: begin ssrf-protection
N8N_SSRF_PROTECTION_ENABLED=true
# HTH Guide Excerpt: end ssrf-protection
