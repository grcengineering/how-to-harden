# =============================================================================
# Buildkite Hardening Code Pack - Example Variable Values
# How to Harden (howtoharden.com)
#
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to version control -- it contains secrets.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform plan
#   terraform apply
# =============================================================================


# -----------------------------------------------------------------------------
# Profile Level
# 1 = Baseline (L1) -- essential controls for all organizations
# 2 = Hardened (L2) -- adds clusters, pipeline permissions, agent isolation
# 3 = Maximum Security (L3) -- adds API IP restrictions
#
# WHAT THIS DOES NOT DO: profile_level does NOT create or delete resources. Every
# resource in this directory is switched on by its own declaration map being
# non-empty, and off by that map being empty. Profile level used to gate the
# for_each on clusters, pipelines and templates, which meant LOWERING it -- or
# simply forgetting `-var="profile_level=2"` on a later apply -- planned a
# DESTROY of those clusters, pipelines and templates. That gate is gone. Set this
# to the level you are operating at; it is a label, not a switch.
# -----------------------------------------------------------------------------
profile_level = 1


# -----------------------------------------------------------------------------
# Buildkite Provider Configuration
# -----------------------------------------------------------------------------

# Your Buildkite organization slug (from your organization URL)
# e.g., for buildkite.com/acme-corp, use "acme-corp"
buildkite_organization = "your-org"

# Buildkite API token -- generate at Personal Settings > API Access Tokens
# Required scopes: GraphQL API access enabled, write_pipelines, read_pipelines
# WARNING: This is a sensitive value. Use environment variables in production:
#   export TF_VAR_buildkite_api_token="bkua_..."
buildkite_api_token = ""


# -----------------------------------------------------------------------------
# Section 1.2: Two-Factor Authentication
# Whether to require 2FA for all organization members
# -----------------------------------------------------------------------------
enforce_2fa = true


# -----------------------------------------------------------------------------
# Section 2.1: Team Permissions
# Define teams with least-privilege defaults
# -----------------------------------------------------------------------------
# All five members_can_* privileges are optional + computed in the provider, so an
# attribute you leave out here is ADOPTED from whatever the Buildkite console
# currently says and is never drift-corrected. Set every one of them explicitly.
# members_can_destroy_packages / members_can_destroy_registries are the
# destructive pair: they let a non-admin erase published artifacts, the registries
# holding them, and the attestations attached to them. Keep both false unless a
# named team owns artifact lifecycle.
teams = {
  platform = {
    description                    = "Platform engineering team"
    privacy                        = "VISIBLE"
    default_team                   = false
    default_member_role            = "MEMBER"
    members_can_create_pipelines   = true
    members_can_create_registries  = true
    members_can_create_suites      = true
    members_can_destroy_packages   = false
    members_can_destroy_registries = false
  }
  developers = {
    description                    = "Development team with read and build access"
    privacy                        = "VISIBLE"
    default_team                   = true
    default_member_role            = "MEMBER"
    members_can_create_pipelines   = false
    members_can_create_registries  = false
    members_can_create_suites      = false
    members_can_destroy_packages   = false
    members_can_destroy_registries = false
  }
  security = {
    description                    = "Security team with audit access"
    privacy                        = "SECRET"
    default_team                   = false
    default_member_role            = "MEMBER"
    members_can_create_pipelines   = false
    members_can_create_registries  = false
    members_can_create_suites      = false
    members_can_destroy_packages   = false
    members_can_destroy_registries = false
  }
}


# -----------------------------------------------------------------------------
# Section 2.2: Pipeline Permissions (control 2.2, an L2 control)
# Pipelines with hardened configurations. This map is the on/off switch for pack
# 2.2; an empty map creates nothing. buildkite_pipeline carries prevent_destroy,
# because a destroyed pipeline takes its build history and its webhook URL with
# it and neither comes back -- so removing an entry fails the plan rather than
# quietly deleting the pipeline.
# -----------------------------------------------------------------------------
pipelines = {
  # "my-app" = {
  #   repository                 = "git@github.com:your-org/my-app.git"
  #   description                = "Main application pipeline"
  #   default_branch             = "main"
  #   branch_configuration       = "main develop release/*"
  #   skip_intermediate_builds   = true
  #   cancel_intermediate_builds = true
  #   default_timeout_in_minutes = 60
  #   maximum_timeout_in_minutes = 120
  #   allow_rebuilds             = true
  #   cluster_id                 = null  # Set to a cluster ID to bind
  #   # PUBLIC | PRIVATE. Always state it: the provider attribute is optional +
  #   # computed, so omitting it makes Terraform adopt the server's current value
  #   # and a console flip to PUBLIC survives every apply.
  #   visibility                 = "PRIVATE"
  # }
}

pipeline_team_access = {
  # "my-app-developers" = {
  #   pipeline_key = "my-app"
  #   team_key     = "developers"
  #   access_level = "BUILD_AND_READ"
  # }
  # "my-app-platform" = {
  #   pipeline_key = "my-app"
  #   team_key     = "platform"
  #   access_level = "MANAGE_BUILD_AND_READ"
  # }
}


# -----------------------------------------------------------------------------
# Section 3.1: Agent Tokens
# Scoped tokens per environment
# -----------------------------------------------------------------------------
# Cluster-scoped registration tokens. `allowed_ip_addresses` is REQUIRED in
# practice: an empty list means unrestricted, and pack 3.1 fails the plan on it.
# ROTATION IS TWO APPLIES. Buildkite tokens have no Terraform-settable expiry and
# the secret is returned exactly once, so replacing a token inside one apply
# revokes the incumbent before anyone can distribute the replacement — the fleet
# then keeps running and quietly stops being able to re-register (pack 3.1,
# TRAP 5). Do NOT edit `rotation_id` in place; it only relabels the live token.
# Instead:
#   apply 1  add `production_gen2` alongside `production` (same cluster, same
#            description, rotation_id = "2") — both tokens valid, new secret in
#            the output; put it in your secret manager
#   then     roll the agent hosts and confirm every one has re-registered
#   apply 2  delete the `production` entry — the plan reads "1 to destroy"
agent_tokens = {
  production = {
    description          = "Agent token for production environment"
    cluster              = "production"
    allowed_ip_addresses = ["203.0.113.0/24"]
    rotation_id          = "1"
  }
  # Phase 1 of a rotation looks exactly like this — uncomment alongside the entry
  # above, apply, roll the hosts, then delete the entry above and apply again.
  # production_gen2 = {
  #   description          = "Agent token for production environment"
  #   cluster              = "production"
  #   allowed_ip_addresses = ["203.0.113.0/24"]
  #   rotation_id          = "2"
  # }
  staging = {
    description          = "Agent token for staging environment"
    cluster              = "staging"
    allowed_ip_addresses = ["198.51.100.0/24"]
    rotation_id          = "1"
  }
}

# Cluster used by any agent_tokens entry that leaves `cluster` null.
agent_token_cluster_name = "Default cluster"

# Set false ONLY to accept an unrestricted registration token deliberately.
agent_token_require_ip_allowlist = true


# -----------------------------------------------------------------------------
# Section 3.2: Agent Clusters (control 3.2, an L2 control)
# Isolated clusters per environment.
#
# COMMENTED OUT ON PURPOSE. var.clusters defaults to {} and this map is the
# on/off switch for pack 3.2 -- uncommenting an entry is what creates a cluster.
# It is left commented so that copying this file and applying it cannot create
# infrastructure you did not ask for. Uncomment the environments you actually
# want, then apply.
#
# Note that buildkite_cluster carries prevent_destroy: once a cluster is created,
# deleting its entry here (or renaming the key, which renames the cluster) fails
# the plan instead of destroying the cluster, its queues and its cluster-scoped
# agent tokens. To retire one deliberately, remove prevent_destroy in
# hth-buildkite-3.02-configure-agent-clusters.tf, apply, then restore it.
# -----------------------------------------------------------------------------
clusters = {
  # production = {
  #   description = "Production deployment agents - restricted access"
  #   color       = "#FF0000"
  #   emoji       = ":lock:"
  # }
  # development = {
  #   description = "Development build agents"
  #   color       = "#00FF00"
  #   emoji       = ":hammer:"
  # }
  # security = {
  #   description = "Security-sensitive build agents"
  #   color       = "#FF8800"
  #   emoji       = ":shield:"
  # }
}

cluster_queues = {
  # "production-default" = {
  #   cluster_key = "production"
  #   key         = "default"
  #   description = "Default production queue"
  # }
  # "production-deploy" = {
  #   cluster_key = "production"
  #   key         = "deploy"
  #   description = "Production deployment queue"
  # }
}


# -----------------------------------------------------------------------------
# Section 4.1: Audit Logging / API Restrictions (L3 only)
# IP addresses allowed to access the Buildkite API
# Empty list allows all (default). Only applied at profile_level >= 3.
# -----------------------------------------------------------------------------
allowed_api_ip_addresses = [
  # "203.0.113.0/24",    # Office egress
  # "198.51.100.0/24",   # VPN egress
]
