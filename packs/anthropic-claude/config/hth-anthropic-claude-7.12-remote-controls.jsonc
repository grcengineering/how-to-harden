// HTH Guide Excerpt: begin code-remote-control-policy
{
  "disableRemoteControl": true,
  "channelsEnabled": false,
  "allowedChannelPlugins": [],
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  }
}
// HTH Guide Excerpt: end code-remote-control-policy
